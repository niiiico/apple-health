# Raw Apple Health export — large, immutable, kept on the NAS cold archive, never in git.
data/
*.db
*.db-wal
*.db-shm
*.xml
*.gpx
export*.zip

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Generated reports (rebuilt from the DB on demand)
reports/

# Xcode (per-user state)
xcuserdata/

# Signed app exports and the local OTA server's TLS key/cert (machine-specific)
distrib/
tools/ota/ca-key.pem
tools/ota/serve/*.pem
tools/ota/serve/*.crt

# OS
.DS_Store
tmp/
