<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Periodic HealthSync cycle: Box → inbox → health.db → Vault (ADR-003).
     Install:
       cp tools/launchd/net.dev2.healthsync.sync.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/net.dev2.healthsync.sync.plist
     Logs: /tmp/healthsync-sync.log -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.dev2.healthsync.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Volumes/nicolas-data/Repositories/apple-health</string>
        <string>python</string>
        <string>/Volumes/nicolas-data/Repositories/apple-health/tools/sync_cycle.py</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/healthsync-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/healthsync-sync.log</string>
</dict>
</plist>
