<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Periodic HealthSync cycle: iCloud → inbox → health.db → Vault (ADR-004).
     Install:
       cp tools/launchd/net.dev2.healthsync.sync.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/net.dev2.healthsync.sync.plist
     Logs: /tmp/healthsync-sync.log -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.dev2.healthsync.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Volumes/nicolas-data/Repositories/apple-health</string>
        <string>ah-sync</string>
    </array>
    <!-- Without this the sync runs but skips Postgres entirely (commands/sync.py
         guards on it), the renderers fall back to the inbox, and coverage
         silently freezes at the last successful instant. The password is not
         here: store.py reads ~/.config/apple-health/db-password. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>APPLE_HEALTH_DSN</key>
        <string>postgresql://apple_health@postgres.int.dev2.net:5432/apple_health?sslmode=require</string>
    </dict>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/healthsync-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/healthsync-sync.log</string>
</dict>
</plist>
